{
  "name": "gon-stock03",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:realtime": "tsx scripts/dev.ts --realtime",
    "dev:web": "vite --host 127.0.0.1 --port 4303 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "vts:test": "tsx scripts/vts-runner.ts",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "lucide-react": "1.73.0",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vite": "8.3.8"
  }
}
