KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=

# 서버 전용. 셸 값 우선. 머신 인증은 dev /kis 응답(Secret Import 포함)을 먼저 적용, KIS 주입 성공 후 공용 dev /stock 조회.
# Machine Identity에 해당 경로 읽기 권한이 필요하다. 선택 키 미설정 시 DART todayRSS.xml로 폴백한다.
OPENDART_API_KEY=

# 공용 dev /stock의 기본 조회 대상. 환경별로 재지정할 수 있다.
INFISICAL_STOCK_PROJECT_ID=890430d6-ff44-4317-9d91-64d912e0d67a
INFISICAL_STOCK_PATH=/stock
